<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0b1020">
  <meta name="description" content="A mobile-friendly trading signal dashboard for stocks, forex and crypto.">
  <title>Signal Center — Markets</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand"><div class="brand-mark">S</div><div><b>Signal Center</b><small>MARKET INTELLIGENCE</small></div></div>
      <div class="side-label">WORKSPACE</div>
      <button class="nav-item active" data-page="dashboard"><span>◫</span> Dashboard</button>
      <button class="nav-item" data-page="signals"><span>⌁</span> Signal scanner</button>
      <button class="nav-item" data-page="watchlist"><span>☆</span> Watchlist</button>
      <div class="sidebar-bottom"><div class="status-dot"></div><span>Local service UI</span><small id="side-mode">CHECKING</small></div>
    </aside>
    <main class="main">
      <header class="topbar">
        <div><div class="eyebrow">MARKET OVERVIEW</div><h1 id="page-title">Trading dashboard</h1></div>
        <div class="top-actions"><span id="data-badge" class="badge muted"><i></i> Checking data</span><button id="refresh" class="icon-button" aria-label="Refresh data" title="Refresh">↻</button></div>
      </header>
      <section class="welcome-row">
        <div><div class="eyebrow">YOUR MARKETS, ONE VIEW</div><h2>Wait for the edge.</h2><p>Scan conditions. Verify the setup. Protect your capital.</p></div>
        <div class="market-time"><span class="pulse"></span><span id="clock">--:--:--</span><small>ZAMBIA TIME · CAT</small></div>
      </section>
      <section class="stat-grid">
        <article class="stat-card"><div class="stat-label">MARKETS COVERED <span>◈</span></div><div class="stat-value">3</div><div class="stat-foot">Stocks · Forex · Crypto</div></article>
        <article class="stat-card"><div class="stat-label">SIGNAL ENGINE <span>⌘</span></div><div class="stat-value small-value" id="engine-stat">Technical</div><div class="stat-foot" id="engine-foot">Checking configuration</div></article>
        <article class="stat-card"><div class="stat-label">DATA MODE <span>◉</span></div><div class="stat-value small-value" id="mode-stat">Checking</div><div class="stat-foot" id="mode-foot">Never assume demo is live</div></article>
      </section>
      <section class="content-grid">
        <article class="panel chart-panel">
          <div class="panel-head"><div><div class="eyebrow">PRICE ACTION</div><h3 id="chart-title">NVDA · 5 minute</h3></div><div class="chart-controls"><select id="market-select" aria-label="Market"><option value="stocks">Stocks</option><option value="forex">Forex</option><option value="crypto">Crypto</option></select><select id="symbol-select" aria-label="Symbol"></select><select id="interval-select" aria-label="Interval"><option value="1min">1m</option><option value="5min" selected>5m</option><option value="15min">15m</option><option value="30min">30m</option><option value="1h">1h</option><option value="4h">4h</option><option value="1day">1D</option></select></div></div>
          <div class="price-line"><div><span id="last-price" class="price">—</span><span id="price-change" class="change neutral">Waiting for data</span></div><span id="candle-time" class="subtle">No candles loaded</span></div>
          <div id="chart-wrap" class="chart-wrap"><div class="chart-empty"><div class="loader"></div><span>Connecting to market data…</span></div></div>
          <div class="chart-legend"><span><i class="legend-line blue"></i> EMA 9</span><span><i class="legend-line purple"></i> EMA 21</span><span id="provider-label">Provider not checked</span></div>
        </article>
        <article class="panel signal-panel">
          <div class="panel-head"><div><div class="eyebrow">LATEST ANALYSIS</div><h3>Signal snapshot</h3></div><span class="live-pill" id="signal-mode">NOT READY</span></div>
          <div class="signal-direction wait" id="signal-direction"><span class="direction-icon">⌁</span><div><small>ENGINE ASSESSMENT</small><strong id="signal-word">WAIT</strong></div></div>
          <p id="signal-summary" class="signal-summary">Load verified live candles to evaluate the current conditions.</p>
          <div class="signal-levels"><div><span>ENTRY</span><b id="entry">—</b></div><div><span>STOP LOSS</span><b id="stop">—</b></div><div><span>TAKE PROFIT</span><b id="target">—</b></div></div>
          <div class="confidence-row"><span>Technical strength</span><b id="strength">—</b></div><div class="meter"><span id="strength-meter"></span></div>
          <div class="risk-note"><span>ⓘ</span><p id="risk-text">Signals are estimates, not guarantees. Always validate risk and execution before trading.</p></div>
          <button id="scan-button" class="primary-button">Scan current market <span>→</span></button>
        </article>
      </section>
      <section class="panel indicator-panel">
        <div class="panel-head"><div><div class="eyebrow">TECHNICAL CHECKS</div><h3>Indicator monitor</h3></div><span class="subtle">Calculated from returned candles</span></div>
        <div class="indicator-grid">
          <div class="indicator"><span>RSI (14)</span><b id="rsi-value">—</b><small id="rsi-label">Waiting for data</small></div>
          <div class="indicator"><span>EMA (9)</span><b id="ema9-value">—</b><small id="ema9-label">Short trend</small></div>
          <div class="indicator"><span>EMA (21)</span><b id="ema21-value">—</b><small id="ema21-label">Longer trend</small></div>
          <div class="indicator"><span>AI REVIEW</span><b id="ai-value">Off</b><small id="ai-label">Optional server key</small></div>
        </div>
      </section>
      <section class="panel bottom-panel">
        <div class="panel-head"><div><div class="eyebrow">SIGNAL LOGIC</div><h3>Why this signal?</h3></div><span class="subtle">Transparent checks</span></div>
        <ul id="reason-list" class="reason-list"><li>Connect live data to calculate indicators.</li></ul>
      </section>
      <footer><span>Signal Center · Educational analysis only</span><span id="footer-status">Waiting for service status</span></footer>
    </main>
  </div>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <script src="/app.js"></script>
</body>
</html>
